<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\View\Element\Template">
        <plugin
            name="LokiCheckout_Csp::addCspInlineScripts"
            type="LokiCheckout\Csp\Plugin\AddCspInlineScripts"/>
    </type>

    <type name="Magento\Framework\App\Config\ScopeConfigInterface">
        <plugin
            name="LokiCheckout_Csp::enableCspConfig"
            type="LokiCheckout\Csp\Plugin\EnableCspConfigPlugin"/>
    </type>

    <type name="LokiCheckout\Csp\Plugin\EnableCspConfigPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
        </arguments>
    </type>
</config>
